---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card.astro";
import Hr from "@components/Hr.astro";
import LinkButton from "@components/LinkButton.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import type { Frontmatter } from "src/types";

const posts = Object.values(
  import.meta.glob<Frontmatter>("../contents/**/*.{md,mdx}", { eager: true })
);

const sortedPosts = getSortedPosts(posts);
const latestPost = sortedPosts[0];

const projects = [
  {
    name: "avoante.md",
    url: "https://avoante.com",
    status: "running",
    size: "4.2K",
    lines: [
      "freelance & web services platform.",
      "websites, branding, and digital",
      "presence for small businesses.",
      "",
      "url: avoante.com",
    ],
  },
  {
    name: "contactbot.md",
    url: null,
    status: "wip",
    size: "3.1K",
    lines: [
      "people memory assistant on telegram.",
      "tracks conversations and follow-ups",
      "so you never forget who's who.",
      "",
      "stack: typescript · telegram · sqlite",
    ],
  },
  {
    name: "aoe2debot.md",
    url: "https://github.com/devjoca/aoe2debot",
    status: "active",
    size: "2.8K",
    lines: [
      "age of empires 2 DE telegram bot.",
      "tracks matches with friends so we",
      "can argue about who's actually good.",
      "",
      "stack: python · telegram",
    ],
  },
];
---

<Layout>
  <Header />
  <main id="main-content">
    <!-- ===== Terminal ===== -->
    <section id="terminal-section">
      <h1 class="sr-only">Joca Pereyra — Backend Developer & Tech Blog</h1>
      <div class="tui">
        <div class="tui-titlebar">
          <div class="tui-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="tui-title">joca@devjoca: ~</span>
        </div>

        <div class="tui-body">
          <div class="line">
            <span class="ps1"
              >joca@devjoca<span class="ps1-sep">:</span><span class="ps1-path"
                >~</span
              ><span class="ps1-dollar">$</span></span
            >
            <span class="cmd">whoami</span>
          </div>
          <div class="output">
            <p>joca — backend dev. curiosity is the engine.</p>
            <p>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;understands the why,
              skips the hype,
            </p>
            <p>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;builds only what's
              needed.
            </p>
            <p>
              &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;best ideas come from
              outside the bubble.
            </p>
          </div>

          <div class="line mt-4">
            <span class="ps1"
              >joca@devjoca<span class="ps1-sep">:</span><span class="ps1-path"
                >~</span
              ><span class="ps1-dollar">$</span></span
            >
            <span class="cmd">echo $STATUS</span>
          </div>
          <div class="output">
            <p>when not coding for work, probably coding for fun.</p>
          </div>

          <div class="line mt-4">
            <span class="ps1"
              >joca@devjoca<span class="ps1-sep">:</span><span class="ps1-path"
                >~</span
              ><span class="ps1-dollar">$</span></span
            >
            <span class="cmd">ls -la projects/</span>
          </div>
          <div class="output ls-output">
            <div class="ls-header">
              <span class="ls-col-perms">-rw-r--r--</span>
              <span class="ls-col-user">joca</span>
              <span class="ls-col-size">size</span>
              <span class="ls-col-name">file</span>
              <span class="ls-col-status">status</span>
            </div>
            {
              projects.map(project => (
                <button
                  class="ls-row"
                  data-project={project.name}
                  aria-expanded="false"
                  aria-label={`View details for ${project.name}`}
                >
                  <span class="ls-col-perms">-rw-r--r--</span>
                  <span class="ls-col-user">joca</span>
                  <span class="ls-col-size">{project.size}</span>
                  <span class="ls-col-name file-link">{project.name}</span>
                  <span
                    class={`ls-col-status ${project.status === "wip" ? "status-wip" : "status-ok"}`}
                  >
                    [{project.status}]
                  </span>
                </button>
              ))
            }
          </div>

          {
            projects.map(project => (
              <div class="cat-block" id={`cat-${project.name}`}>
                <div class="line">
                  <span class="ps1">
                    joca@devjoca
                    <>
                      <span class="ps1-sep">:</span>
                      <span class="ps1-path">~</span>
                      <span class="ps1-dollar">$</span>
                    </>
                  </span>
                  <span class="cmd">cat projects/{project.name}</span>
                </div>
                <div class="output cat-content">
                  {project.lines.map(line => (
                    <p>{line === "" ? "\u00A0" : line}</p>
                  ))}
                  {project.url && (
                    <p class="mt-2">
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="cat-link"
                      >
                        → {project.url.replace("https://", "")}
                      </a>
                    </p>
                  )}
                </div>
              </div>
            ))
          }

          <div class="line mt-4">
            <span class="ps1"
              >joca@devjoca<span class="ps1-sep">:</span><span class="ps1-path"
                >~</span
              ><span class="ps1-dollar">$</span></span
            >
            <span class="cursor">█</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== Latest Post ===== -->
    {
      latestPost && (
        <section id="latest-post">
          <h2>Latest Post</h2>
          <ul>
            <Card
              href={`/posts/${slugify(latestPost.frontmatter)}`}
              post={latestPost.frontmatter}
              secHeading={false}
            />
          </ul>
          <div class="all-posts-btn-wrapper">
            <LinkButton href="/posts">
              All Posts
              <svg xmlns="http://www.w3.org/2000/svg">
                <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z" />
              </svg>
            </LinkButton>
          </div>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";

  /* ===== Terminal Section ===== */
  #terminal-section {
    @apply pt-8 pb-2 max-w-3xl mx-auto px-4;
  }

  /* ===== TUI Window ===== */
  .tui {
    @apply rounded-lg overflow-hidden border border-skin-line;
  }
  .tui-titlebar {
    @apply flex items-center gap-3 px-4 py-2.5 border-b border-skin-line;
    background-color: rgb(var(--color-card-muted));
  }
  .tui-dots {
    @apply flex gap-1.5;
  }
  .dot {
    @apply w-2.5 h-2.5 rounded-full;
  }
  .dot-red {
    background: #ff5f56;
  }
  .dot-yellow {
    background: #ffbd2e;
  }
  .dot-green {
    background: #27c93f;
  }
  .tui-title {
    @apply text-xs opacity-50 select-none;
    font-family: var(--font-mono);
  }

  /* ===== Terminal Body ===== */
  .tui-body {
    @apply p-5 sm:p-6;
    background-color: rgb(var(--color-card));
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
  }

  /* ===== Prompt Line ===== */
  .line {
    @apply flex items-center gap-2 flex-wrap;
  }
  .ps1 {
    @apply font-bold select-none whitespace-nowrap;
    color: rgb(var(--color-accent));
    font-size: 0.75rem;
  }
  .ps1-sep {
    color: rgb(var(--color-text-base));
    opacity: 0.4;
  }
  .ps1-path {
    color: rgb(var(--color-accent));
  }
  .ps1-dollar {
    color: rgb(var(--color-text-base));
    opacity: 0.4;
    margin-left: 1px;
  }
  .cmd {
    color: rgb(var(--color-text-base));
  }

  /* ===== Output ===== */
  .output {
    @apply mt-1 mb-1;
    font-size: 0.8rem;
  }
  .output p {
    @apply leading-relaxed;
  }
  .dim {
    @apply opacity-45;
  }

  /* ===== ls -la listing ===== */
  .ls-output {
    @apply mt-2;
  }
  .ls-header {
    @apply hidden sm:grid opacity-60 text-xs pb-1 mb-1;
    grid-template-columns: 7rem 3rem 3rem 1fr 5rem;
    gap: 0.5rem;
    border-bottom: 1px dashed rgb(var(--color-border));
  }
  .ls-row {
    @apply w-full grid items-center text-left cursor-pointer
           rounded-sm py-1 px-0
           transition-colors duration-150;
    grid-template-columns: 7rem 3rem 3rem 1fr 5rem;
    gap: 0.5rem;
    background: transparent;
    border: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgb(var(--color-text-base));
  }
  .ls-row:hover {
    background-color: rgb(var(--color-accent) / 0.1);
  }
  .ls-row[aria-expanded="true"] {
    background-color: rgb(var(--color-accent) / 0.06);
  }
  @media (max-width: 639px) {
    .ls-row {
      grid-template-columns: 1fr auto;
      gap: 0.25rem;
    }
    .ls-col-perms,
    .ls-col-user,
    .ls-col-size {
      display: none;
    }
  }
  .ls-col-perms {
    @apply opacity-35 text-xs;
  }
  .ls-col-user {
    @apply opacity-35 text-xs;
  }
  .ls-col-size {
    @apply opacity-45 text-xs text-right;
  }
  .ls-col-name {
    @apply font-semibold;
  }
  .file-link {
    color: rgb(var(--color-accent));
  }
  .ls-col-status {
    @apply text-xs text-right;
  }
  .status-ok {
    color: #27c93f;
  }
  .status-wip {
    color: #ffbd2e;
  }

  /* ===== Cat Blocks (expandable) ===== */
  .cat-block {
    @apply overflow-hidden;
    max-height: 0;
    opacity: 0;
    transition:
      max-height 0.3s ease,
      opacity 0.2s ease,
      margin 0.3s ease;
    margin-top: 0;
  }
  .cat-block.open {
    max-height: 20rem;
    opacity: 1;
    margin-top: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .cat-content {
    @apply pl-3 ml-1;
    border-left: 2px solid rgb(var(--color-border));
  }
  .cat-link {
    color: rgb(var(--color-accent));
    @apply underline underline-offset-4 decoration-dashed hover:opacity-70;
  }

  /* ===== Blinking Cursor ===== */
  .cursor {
    color: rgb(var(--color-accent));
    animation: blink 1s step-end infinite;
    font-size: 0.8rem;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ===== Latest Post Section ===== */
  #latest-post {
    @apply pt-10 pb-6 max-w-3xl mx-auto px-4;
  }
  #latest-post h2 {
    @apply font-semibold tracking-wide;
    font-family: var(--font-heading);
    font-size: 1.75rem;
  }
  .all-posts-btn-wrapper {
    @apply text-center my-8;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".ls-row").forEach(row => {
    row.addEventListener("click", () => {
      const projectName = row.dataset.project;
      if (!projectName) return;

      const catBlock = document.getElementById(`cat-${projectName}`);
      if (!catBlock) return;

      const isOpen = catBlock.classList.contains("open");

      // Close all open blocks
      document.querySelectorAll(".cat-block.open").forEach(block => {
        block.classList.remove("open");
      });
      document.querySelectorAll('.ls-row[aria-expanded="true"]').forEach(r => {
        r.setAttribute("aria-expanded", "false");
      });

      // Toggle clicked
      if (!isOpen) {
        catBlock.classList.add("open");
        row.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
